# Version configuration.
#
# This repository builds one GitHub release per supported Agda release, tagged
# `v<agda>-als-<sha>` (for example `v2.8.0-als-e6541f8`). Everything lives on
# `main`: to cut a release, set the values below, then push the tag. CI builds
# the artifacts from that tag and attaches them to the GitHub release; artifacts
# are never committed, and there is no per-version branch.
#
# All revisions are pinned. See ../UPDATING.md for how to move to a new Agda
# release.

# Agda release this branch distributes.
AGDA_VERSION=2.8.0

# File stem of the built artifact: ${ALS_WASM_NAME}.wasm / .wasm.gz
ALS_WASM_NAME=als-2.8ext

# Matching agda-stdlib release (the version tag, without the leading `v`).
STDLIB_VERSION=2.3

# The agda-language-server Cabal flag that selects this Agda version
# (declared in agda-language-server.cabal).
ALS_AGDA_FLAG=Agda-2-8-0

# Pinned upstream revisions.
ALS_REVISION=e65419f89e3152c2922e948b3e4d24580172bc6a
AGDA_REVISION=e2f8c69414fa115328280ecc4de1d2b7a23be7fa
GHC_WASM_META_REVISION=c3f44696d29aaeadd755d69c51735954bfcd59db
GHC_WASM_META_FLAVOUR=9.10

# Cross-compile patch version for the `entropy` package (see patches/).
ENTROPY_VERSION=0.4.1.11
